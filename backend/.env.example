# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hrms
DB_USER=postgres
DB_PASSWORD=replace-me

# Exact public frontend origin(s) accepted by state-changing API requests.
# Use the same origin from which users open the HRMS frontend.
APP_ORIGIN=http://localhost:3001
FRONTEND_URL=http://localhost:3001

# Optional explicit password-reset link origin.
# When omitted, the backend uses FRONTEND_URL, then APP_ORIGIN.
PASSWORD_RESET_BASE_URL=http://localhost:3001

# Required, stable secret for HMAC-hashing rate-limit identifiers.
# Generate a unique value with:
# node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
# Keep it identical across all backend instances and do not rotate casually.
RATE_LIMIT_HMAC_SECRET=replace-with-a-unique-random-secret-of-at-least-32-bytes

# Optional extra IP-level rate limiting.
# Set only when your reverse proxy overwrites this header with exactly one
# trusted client IP. Leave blank if your platform does not provide such a
# header; per-account and per-reset-token rate limits remain enforced.
RATE_LIMIT_TRUSTED_IP_HEADER=

# Email delivery
# EMAIL_MODE must be "sandbox" or "live".
EMAIL_MODE=sandbox
MAILTRAP_API_TOKEN=
MAILTRAP_INBOX_ID=
MAIL_FROM_EMAIL=no-reply@example.com
MAIL_FROM_NAME=HRMS Platform

# For EMAIL_MODE=live, configure the deployed Apps Script /exec URL and secret.
GOOGLE_APPS_SCRIPT_URL=
HRMS_EMAIL_SECRET=

# Independent session secrets (each must be at least 32 characters, and all
# three must be different).
SESSION_PASSWORD=replace-with-a-unique-session-secret-32-characters-minimum
ORGANIZATION_SESSION_PASSWORD=replace-with-another-unique-session-secret-32-characters
EMPLOYEE_SESSION_PASSWORD=replace-with-a-third-unique-session-secret-32-characters
